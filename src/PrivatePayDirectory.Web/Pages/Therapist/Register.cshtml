@page
@model PrivatePayDirectory.Web.Pages.Therapist.RegisterModel
@{
    ViewData["Title"] = "Register as a Therapist";
}

<div class="register-container">
    <h1>Register as a Therapist</h1>
    <p>Create your therapist profile. It will be reviewed by an administrator before appearing in the directory.</p>
    <form method="post">
        <button type="submit" class="btn btn-primary">Create My Profile</button>
    </form>
</div>
