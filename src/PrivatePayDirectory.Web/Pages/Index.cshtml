@page
@model IndexModel
@using PrivatePayDirectory.Core.Enums
@using PrivatePayDirectory.Core.Models
@{
    ViewData["Title"] = "Find a Private-Pay Therapist";
    // Therapists lead; the other professions are cross-promoted below
    var lead = Taxonomy.Info(Profession.Therapist);
    var others = Taxonomy.Professions.Where(p => p != lead);
}

<section class="w-full bg-gradient-to-br from-[#4a7c59] to-[#3d5244] py-20 sm:py-24 px-4 sm:px-6">
    <div class="max-w-3xl mx-auto text-center text-white">
        <h1 class="text-4xl md:text-5xl font-bold mb-6 leading-tight">@lead.Headline</h1>
        <p class="text-lg md:text-xl text-white/80 mb-10">@lead.Tagline</p>
        <a asp-page="/Directory" asp-route-slug="@lead.Slug" class="inline-block px-8 py-4 bg-white text-primary font-semibold rounded-xl shadow hover:shadow-md hover:bg-slate-50 transition-all">
            Browse @lead.PluralName
        </a>
    </div>
</section>

<section class="max-w-7xl mx-auto px-4 sm:px-6 py-12">
    <h2 class="text-lg font-semibold text-slate-800 mb-4">Also find</h2>
    <partial name="_ProfessionCards" model="others" />
</section>
