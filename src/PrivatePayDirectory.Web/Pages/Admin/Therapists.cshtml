@page
@model PrivatePayDirectory.Web.Pages.Admin.TherapistsModel
@{
    ViewData["Title"] = "Admin — Therapist Profiles";
}

<div class="max-w-7xl mx-auto px-6 py-10">
    <h1 class="text-2xl font-bold text-slate-900 mb-6">Therapist Profiles</h1>

    @if (TempData["Success"] != null)
    {
        <div class="mb-4 px-4 py-3 bg-green-50 border border-green-200 text-green-700 rounded-lg text-sm">@TempData["Success"]</div>
    }

    <div class="bg-white rounded-xl border border-slate-200 shadow-sm overflow-hidden">
        <table class="w-full text-sm">
            <thead class="bg-slate-50 border-b border-slate-200">
                <tr>
                    <th class="px-4 py-3 text-left font-semibold text-slate-600">Name</th>
                    <th class="px-4 py-3 text-left font-semibold text-slate-600">Email</th>
                    <th class="px-4 py-3 text-left font-semibold text-slate-600">Visible</th>
                    <th class="px-4 py-3 text-left font-semibold text-slate-600">Created</th>
                    <th class="px-4 py-3 text-left font-semibold text-slate-600">Actions</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-slate-100">
                @foreach (var t in Model.Therapists)
                {
                    <tr class="hover:bg-slate-50 transition-colors @(t.IsVisible ? "" : "bg-amber-50/40")">
                        <td class="px-4 py-3 text-slate-800">
                            @if (t.IsVisible)
                            {
                                <a asp-page="/Therapist/Profile" asp-route-id="@t.TherapistId" class="text-primary hover:underline font-medium">
                                    @t.FirstName @t.LastName
                                </a>
                            }
                            else
                            {
                                @($"{t.FirstName} {t.LastName}")
                            }
                        </td>
                        <td class="px-4 py-3 text-slate-600">@t.Email</td>
                        <td class="px-4 py-3">
                            @if (t.IsVisible)
                            {
                                <span class="px-2 py-0.5 bg-green-100 text-green-700 text-xs rounded-full font-medium">✓ Visible</span>
                            }
                            else
                            {
                                <span class="px-2 py-0.5 bg-amber-100 text-amber-700 text-xs rounded-full font-medium">⏳ Pending</span>
                            }
                        </td>
                        <td class="px-4 py-3 text-slate-600">@t.CreatedAt.ToString("MM/dd/yyyy")</td>
                        <td class="px-4 py-3">
                            <form method="post">
                                <input type="hidden" name="therapistId" value="@t.TherapistId" />
                                <input type="hidden" name="isVisible" value="@(!t.IsVisible)" />
                                <button type="submit" class="px-3 py-1 text-xs font-semibold rounded-lg border transition-colors @(t.IsVisible ? "border-amber-400 text-amber-700 hover:bg-amber-50" : "border-green-500 text-green-700 hover:bg-green-50")">
                                    @(t.IsVisible ? "Hide" : "Approve")
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
