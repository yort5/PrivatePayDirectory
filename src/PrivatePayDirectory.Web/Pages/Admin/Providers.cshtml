@page
@model PrivatePayDirectory.Web.Pages.Admin.ProvidersModel
@{
    ViewData["Title"] = "Admin — Provider Approvals";
}

<div class="max-w-5xl mx-auto px-6 py-10">

    <div class="flex items-center justify-between mb-8">
        <div>
            <h1 class="text-2xl font-bold text-slate-900">Provider Approvals</h1>
            <p class="text-sm text-slate-500 mt-1">Review pending submissions and manage directory visibility.</p>
        </div>
        <div class="flex gap-3 text-sm">
            <span class="px-3 py-1.5 bg-amber-100 text-amber-800 rounded-full font-medium">
                @Model.Pending.Count pending
            </span>
            <span class="px-3 py-1.5 bg-green-100 text-green-800 rounded-full font-medium">
                @Model.Approved.Count approved
            </span>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="mb-6 flex gap-3 bg-green-50 border border-green-200 text-green-800 text-sm rounded-lg px-4 py-3">
            <span class="material-symbols-outlined text-base flex-shrink-0 mt-0.5">check_circle</span>
            <span>@TempData["Success"]</span>
        </div>
    }

    {{-- Pending --}}
    <section class="mb-10">
        <h2 class="text-base font-semibold text-slate-700 mb-4 flex items-center gap-2">
            <span class="material-symbols-outlined text-amber-500 text-base">schedule</span>
            Pending Review
        </h2>

        @if (!Model.Pending.Any())
        {
            <div class="bg-white rounded-xl border border-slate-200 px-6 py-10 text-center text-slate-400 text-sm">
                <span class="material-symbols-outlined text-3xl block mb-2">task_alt</span>
                No profiles awaiting review.
            </div>
        }
        else
        {
            <div class="space-y-4">
                @foreach (var p in Model.Pending)
                {
                    <div class="bg-white rounded-xl border border-amber-200 shadow-sm overflow-hidden">
                        <div class="flex gap-5 p-5">
                            <img src="@(p.ProfilePhotoKey != null ? Model.GetPhotoUrl(p.ProfilePhotoKey) : "/images/default-profile.svg")"
                                 alt="@p.FirstName @p.LastName"
                                 class="h-20 w-20 rounded-full object-cover flex-shrink-0 border border-slate-200" />
                            <div class="flex-1 min-w-0">
                                <div class="flex items-start justify-between gap-4">
                                    <div>
                                        <h3 class="font-bold text-slate-900">@p.FirstName @p.LastName
                                            @if (!string.IsNullOrEmpty(p.Title))
                                            {
                                                <span class="text-primary font-normal text-sm">, @p.Title</span>
                                            }
                                        </h3>
                                        <p class="text-xs text-slate-500 mt-0.5">
                                            @Model.GetProfessionDisplay(p.Profession) · @p.Email · Submitted @p.CreatedAt.ToString("MMM d, yyyy")
                                        </p>
                                    </div>
                                    <div class="flex items-center gap-2 flex-shrink-0">
                                        <a asp-page="/Provider/Profile" asp-route-id="@p.ProviderId"
                                           class="px-3 py-1.5 text-xs font-medium text-slate-600 border border-slate-300 rounded-lg hover:bg-slate-50 transition-colors">
                                            Preview
                                        </a>
                                        <form method="post">
                                            <input type="hidden" name="providerId" value="@p.ProviderId" />
                                            <input type="hidden" name="isVisible" value="true" />
                                            <button type="submit"
                                                    class="px-3 py-1.5 text-xs font-semibold text-white bg-green-600 rounded-lg hover:bg-green-700 transition-colors">
                                                Approve
                                            </button>
                                        </form>
                                    </div>
                                </div>

                                @if (!string.IsNullOrWhiteSpace(p.Bio))
                                {
                                    <p class="text-sm text-slate-600 mt-2 line-clamp-2">@p.Bio</p>
                                }

                                <div class="flex flex-wrap gap-3 mt-3 text-xs text-slate-500">
                                    @if (p.OffersVirtual)
                                    {
                                        <span class="flex items-center gap-1">
                                            <span class="material-symbols-outlined text-sm text-primary">videocam</span>
                                            Virtual (@string.Join(", ", p.LicensedVirtualStates))
                                        </span>
                                    }
                                    @if (p.OffersInPerson)
                                    {
                                        <span class="flex items-center gap-1">
                                            <span class="material-symbols-outlined text-sm text-primary">location_on</span>
                                            In-Person (@p.Offices.Count location@(p.Offices.Count != 1 ? "s" : ""))
                                        </span>
                                    }
                                    @if (p.Specialties.Any())
                                    {
                                        <span class="flex items-center gap-1">
                                            <span class="material-symbols-outlined text-sm">label</span>
                                            @string.Join(", ", p.Specialties.Take(3))@(p.Specialties.Count > 3 ? $" +{p.Specialties.Count - 3}" : "")
                                        </span>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </section>

    {{-- Approved --}}
    <section>
        <h2 class="text-base font-semibold text-slate-700 mb-4 flex items-center gap-2">
            <span class="material-symbols-outlined text-green-600 text-base">check_circle</span>
            Approved
        </h2>

        @if (!Model.Approved.Any())
        {
            <div class="bg-white rounded-xl border border-slate-200 px-6 py-8 text-center text-slate-400 text-sm">
                No approved profiles yet.
            </div>
        }
        else
        {
            <div class="bg-white rounded-xl border border-slate-200 shadow-sm overflow-hidden">
                <table class="w-full text-sm">
                    <thead class="bg-slate-50 border-b border-slate-200">
                        <tr>
                            <th class="px-4 py-3 text-left font-semibold text-slate-600">Name</th>
                            <th class="px-4 py-3 text-left font-semibold text-slate-600">Profession</th>
                            <th class="px-4 py-3 text-left font-semibold text-slate-600">Email</th>
                            <th class="px-4 py-3 text-left font-semibold text-slate-600">Session Type</th>
                            <th class="px-4 py-3 text-left font-semibold text-slate-600">Approved</th>
                            <th class="px-4 py-3"></th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-100">
                        @foreach (var p in Model.Approved)
                        {
                            <tr class="hover:bg-slate-50 transition-colors">
                                <td class="px-4 py-3">
                                    <a asp-page="/Provider/Profile" asp-route-id="@p.ProviderId"
                                       class="font-medium text-primary hover:underline">
                                        @p.FirstName @p.LastName
                                    </a>
                                    @if (!string.IsNullOrEmpty(p.Title))
                                    {
                                        <span class="text-slate-400 text-xs ml-1">@p.Title</span>
                                    }
                                </td>
                                <td class="px-4 py-3 text-slate-500 text-xs">@Model.GetProfessionDisplay(p.Profession)</td>
                                <td class="px-4 py-3 text-slate-600">@p.Email</td>
                                <td class="px-4 py-3 text-slate-600">
                                    @if (p.OffersVirtual && p.OffersInPerson) { <span>Virtual + In-Person</span> }
                                    else if (p.OffersVirtual) { <span>Virtual</span> }
                                    else if (p.OffersInPerson) { <span>In-Person</span> }
                                    else { <span class="text-slate-400 italic">Not set</span> }
                                </td>
                                <td class="px-4 py-3 text-slate-500">@p.UpdatedAt.ToString("MMM d, yyyy")</td>
                                <td class="px-4 py-3 text-right">
                                    <form method="post" class="inline">
                                        <input type="hidden" name="providerId" value="@p.ProviderId" />
                                        <input type="hidden" name="isVisible" value="false" />
                                        <button type="submit"
                                                class="px-3 py-1 text-xs font-medium text-amber-700 border border-amber-300 rounded-lg hover:bg-amber-50 transition-colors">
                                            Hide
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>

</div>
