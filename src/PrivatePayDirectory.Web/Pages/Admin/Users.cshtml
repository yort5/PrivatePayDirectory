@page
@model PrivatePayDirectory.Web.Pages.Admin.UsersModel
@{
    ViewData["Title"] = "Admin — Users";
}

<div class="max-w-7xl mx-auto px-4 sm:px-6 py-6 sm:py-10">
    <h1 class="text-2xl font-bold text-slate-900 mb-6">Users</h1>

    @if (TempData["Success"] != null)
    {
        <div class="mb-4 px-4 py-3 bg-green-50 border border-green-200 text-green-700 rounded-lg text-sm">@TempData["Success"]</div>
    }

    <div class="bg-white rounded-xl border border-slate-200 shadow-sm overflow-x-auto">
        <table class="w-full text-sm">
            <thead class="bg-slate-50 border-b border-slate-200">
                <tr>
                    <th class="px-4 py-3 text-left font-semibold text-slate-600">Email</th>
                    <th class="px-4 py-3 text-left font-semibold text-slate-600">Role</th>
                    <th class="px-4 py-3 text-left font-semibold text-slate-600">Managed Professions</th>
                    <th class="px-4 py-3 text-left font-semibold text-slate-600">Joined</th>
                    <th class="px-4 py-3 text-left font-semibold text-slate-600">Actions</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-slate-100">
                @foreach (var u in Model.Users)
                {
                    <tr class="hover:bg-slate-50 transition-colors">
                        <td class="px-4 py-3 text-slate-800">@u.Email</td>
                        <td class="px-4 py-3 text-slate-600">@u.Role</td>
                        <td class="px-4 py-3 text-slate-500 text-xs">
                            @if (u.Role == PrivatePayDirectory.Core.Enums.UserRole.Administrator && u.ManagedProfessions is { Count: > 0 } mp)
                            {
                                @string.Join(", ", mp.Select(p => PrivatePayDirectory.Core.Models.Taxonomy.ProfessionDisplay[p]))
                            }
                            else if (u.Role == PrivatePayDirectory.Core.Enums.UserRole.Administrator)
                            {
                                <span class="italic">All professions</span>
                            }
                            else
                            {
                                <span class="text-slate-300">—</span>
                            }
                        </td>
                        <td class="px-4 py-3 text-slate-600">@u.CreatedAt.ToString("MM/dd/yyyy")</td>
                        <td class="px-4 py-3">
                            <form method="post" class="space-y-2">
                                <input type="hidden" name="userId" value="@u.UserId" />
                                <div class="flex items-center gap-2">
                                    <select name="role" class="rounded-lg border-slate-300 text-xs focus:ring-primary focus:border-primary py-1">
                                        @foreach (var role in Model.AllRoles)
                                        {
                                            <option value="@role" selected="@(u.Role.ToString() == role)">@role</option>
                                        }
                                    </select>
                                    <button type="submit" class="px-3 py-1 text-xs font-semibold rounded-lg bg-primary text-white hover:bg-primary/90 transition-colors">
                                        Update
                                    </button>
                                </div>
                                <div class="flex flex-wrap gap-x-3 gap-y-1">
                                    @foreach (var profession in Model.AllProfessions)
                                    {
                                        <label class="flex items-center gap-1 text-xs text-slate-600 cursor-pointer">
                                            <input type="checkbox" name="managedProfessions" value="@profession"
                                                   checked="@(u.ManagedProfessions?.Contains(profession) ?? false)"
                                                   class="h-3 w-3 rounded border-slate-300 text-primary focus:ring-primary" />
                                            @PrivatePayDirectory.Core.Models.Taxonomy.ProfessionDisplay[profession]
                                        </label>
                                    }
                                    <span class="text-xs text-slate-400 italic">Admin scope (empty = all)</span>
                                </div>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
