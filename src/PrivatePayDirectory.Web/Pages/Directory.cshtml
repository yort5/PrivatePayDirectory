@page
@model PrivatePayDirectory.Web.Pages.DirectoryModel
@{
    ViewData["Title"] = "Provider Directory";
}

<div class="max-w-7xl mx-auto px-6 py-10 flex gap-8 items-start">
    <!-- Sidebar Filters -->
    <aside class="w-72 flex-shrink-0 bg-white rounded-xl border border-slate-200 shadow-sm p-6">
        <div class="flex items-center justify-between mb-5">
            <h2 class="font-semibold text-slate-800 text-base">Filter Results</h2>
            <a href="/Directory" class="text-sm text-primary hover:underline">Clear</a>
        </div>
        <form method="get" class="space-y-5">
            <!-- Profession -->
            <div>
                <label class="block text-xs font-semibold text-slate-500 uppercase tracking-wide mb-1">Profession</label>
                <select name="profession" class="w-full rounded-lg border-slate-300 text-sm focus:ring-primary focus:border-primary"
                        onchange="this.form.submit()">
                    <option value="">Any</option>
                    @foreach (var (value, display) in Model.ProfessionOptions)
                    {
                        <option value="@value" selected="@(Model.Filter.Profession == value)">@display</option>
                    }
                </select>
            </div>

            <!-- Session Mode -->
            <div>
                <label class="block text-xs font-semibold text-slate-500 uppercase tracking-wide mb-1">Session Mode</label>
                <select name="sessionType" asp-items="Model.SessionTypeOptions" class="w-full rounded-lg border-slate-300 text-sm focus:ring-primary focus:border-primary">
                    <option value="">Any</option>
                </select>
            </div>

            <!-- Specialty -->
            <div>
                <label class="block text-xs font-semibold text-slate-500 uppercase tracking-wide mb-1">Specialty</label>
                <select name="specialty" class="w-full rounded-lg border-slate-300 text-sm focus:ring-primary focus:border-primary">
                    <option value="">Any</option>
                    @foreach (var sp in Model.Specialties)
                    {
                        <option value="@sp" selected="@(Model.Filter.Specialty == sp)">@sp</option>
                    }
                </select>
            </div>

            <!-- Language -->
            <div>
                <label class="block text-xs font-semibold text-slate-500 uppercase tracking-wide mb-1">Language</label>
                <select name="language" class="w-full rounded-lg border-slate-300 text-sm focus:ring-primary focus:border-primary">
                    <option value="">Any</option>
                    @foreach (var lang in Model.Languages)
                    {
                        <option value="@lang" selected="@(Model.Filter.Language == lang)">@lang</option>
                    }
                </select>
            </div>

            <!-- Accepting New Clients -->
            <div>
                <label class="flex items-center gap-2 text-sm text-slate-700 cursor-pointer">
                    <input type="checkbox" name="acceptingClients" value="true"
                           checked="@(Model.Filter.AcceptingNewClients == true)"
                           class="rounded border-slate-300 text-primary focus:ring-primary" />
                    Accepting New Clients
                </label>
            </div>

            <!-- Name Search -->
            <div>
                <label class="block text-xs font-semibold text-slate-500 uppercase tracking-wide mb-1">Name</label>
                <input type="text" name="name" placeholder="Search by name"
                       value="@Model.Filter.NameContains"
                       class="w-full rounded-lg border-slate-300 text-sm focus:ring-primary focus:border-primary" />
            </div>

            <button type="submit" class="w-full py-2.5 bg-primary text-white font-semibold rounded-lg hover:bg-primary/90 transition-colors">
                Apply Filters
            </button>
        </form>
    </aside>

    <!-- Main content -->
    <div class="flex-1 min-w-0">
        <div class="mb-6">
            <h2 class="text-2xl font-bold text-slate-900">
                @if (Model.Filter.Profession.HasValue)
                {
                    @(PrivatePayDirectory.Core.Models.Taxonomy.ProfessionDisplay[Model.Filter.Profession.Value] + " Directory")
                }
                else
                {
                    <text>Provider Directory</text>
                }
            </h2>
            <p class="text-slate-500 mt-1">@Model.Providers.Count provider(s) found</p>
        </div>

        @if (Model.Providers.Any())
        {
            <div class="grid grid-cols-1 xl:grid-cols-2 gap-6">
                @foreach (var p in Model.Providers)
                {
                    <div class="bg-white rounded-xl border border-slate-200 shadow-sm hover:shadow-md transition-shadow flex flex-row overflow-hidden">
                        @if (p.ProfilePhotoKey != null)
                        {
                            <img src="@Model.GetPhotoUrl(p.ProfilePhotoKey)" alt="@p.FirstName @p.LastName"
                                 class="w-40 h-48 object-cover flex-shrink-0 rounded-l-xl" />
                        }
                        else
                        {
                            <img src="~/images/default-profile.svg" alt="@p.FirstName @p.LastName"
                                 class="w-40 h-48 object-cover flex-shrink-0 rounded-l-xl" />
                        }
                        <div class="p-5 flex flex-col flex-1 min-w-0">
                            <a asp-page="/Provider/Profile" asp-route-id="@p.ProviderId"
                               class="font-bold text-slate-900 hover:text-primary transition-colors truncate">
                                @p.FirstName @p.LastName
                            </a>
                            <p class="text-primary text-xs font-medium mt-0.5">@p.Title</p>
                            <p class="text-slate-400 text-xs mt-0.5">@PrivatePayDirectory.Core.Models.Taxonomy.ProfessionDisplay[p.Profession]</p>
                            @if (!string.IsNullOrWhiteSpace(p.Bio))
                            {
                                <p class="text-slate-500 text-sm mt-2 line-clamp-2">@p.Bio</p>
                            }
                            @if (p.Specialties.Any())
                            {
                                <div class="flex flex-wrap gap-1 mt-3">
                                    @foreach (var sp in p.Specialties.Take(3))
                                    {
                                        <span class="px-2 py-0.5 bg-slate-100 text-slate-600 text-xs rounded-full">@sp</span>
                                    }
                                </div>
                            }
                            <div class="flex items-center justify-between mt-auto pt-3">
                                <div class="flex items-center gap-2 text-slate-400">
                                    @if (p.OffersVirtual)
                                    {
                                        <span class="material-symbols-outlined text-base" title="Virtual">videocam</span>
                                    }
                                    @if (p.OffersInPerson)
                                    {
                                        <span class="material-symbols-outlined text-base" title="In-Person">person</span>
                                    }
                                </div>
                                <a asp-page="/Provider/Profile" asp-route-id="@p.ProviderId"
                                   class="px-3 py-1.5 rounded-lg border border-primary text-primary text-xs font-semibold hover:bg-primary/5 transition-colors">
                                    View Profile
                                </a>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="text-center py-20 text-slate-400">
                <span class="material-symbols-outlined text-5xl mb-3 block">search_off</span>
                <p class="text-lg font-medium">No providers match your filters.</p>
                <p class="text-sm mt-1">Try adjusting your search.</p>
            </div>
        }
    </div>
</div>
