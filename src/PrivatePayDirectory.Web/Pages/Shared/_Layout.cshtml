<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Private Pay Directory</title>
    <script type="importmap"></script>
    <script src="https://cdn.tailwindcss.com?plugins=forms"></script>
    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet"/>
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200" rel="stylesheet"/>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        primary: "#4a7c59",
                    },
                    fontFamily: {
                        display: ["Manrope", "sans-serif"]
                    }
                }
            }
        }
    </script>
    <style>
        body { font-family: 'Manrope', sans-serif; }
        .material-symbols-outlined { font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24; }
    </style>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/PrivatePayDirectory.Web.styles.css" asp-append-version="true" />
</head>
<body class="bg-[#f8faf9] text-slate-900 min-h-screen">
    <header class="sticky top-0 z-50 bg-white border-b border-slate-200 shadow-sm">
        <div class="max-w-7xl mx-auto px-6">
            <nav class="flex items-center justify-between h-16">
                <a asp-area="" asp-page="/Index" class="flex items-center gap-2 font-bold text-lg text-primary no-underline">
                    <span class="material-symbols-outlined text-primary">psychology</span>
                    Private Pay Directory
                </a>
                <div class="flex items-center gap-6">
                    <a asp-area="" asp-page="/Directory" class="text-slate-600 hover:text-primary font-medium transition-colors">Directory</a>
                    @if (User.IsInRole("Administrator"))
                    {
                        <a asp-area="" asp-page="/Admin/Therapists" class="text-slate-600 hover:text-primary font-medium transition-colors">Admin</a>
                    }
                </div>
                <div class="flex items-center gap-3">
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        @if (User.IsInRole("Therapist"))
                        {
                            <a asp-area="" asp-page="/Therapist/Edit" class="text-slate-600 hover:text-primary font-medium transition-colors">My Profile</a>
                        }
                        else
                        {
                            <a asp-area="" asp-page="/Therapist/Register" class="text-slate-600 hover:text-primary font-medium transition-colors">Join as Therapist</a>
                        }
                        <form method="post" action="/Account/Logout" style="display:inline">
                            <button type="submit" class="text-slate-600 hover:text-primary font-medium transition-colors bg-transparent border-0 cursor-pointer p-0">Sign Out</button>
                        </form>
                    }
                    else
                    {
                        <a asp-page="/Account/Login" class="px-4 py-2 rounded-lg border border-primary text-primary font-medium hover:bg-primary/5 transition-colors">Sign In</a>
                        <a asp-page="/Account/Register" class="px-4 py-2 rounded-lg bg-primary text-white font-medium hover:bg-primary/90 transition-colors">Register</a>
                    }
                </div>
            </nav>
        </div>
    </header>

    <main role="main">
        @RenderBody()
    </main>

    <footer class="border-t border-slate-200 mt-16 py-8">
        <div class="max-w-7xl mx-auto px-6 text-slate-500 text-sm">
            &copy; 2026 - Private Pay Directory
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
